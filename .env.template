# Database (OBLIGATOIRE)
# Utilisée par Prisma pour la connexion PostgreSQL
DATABASE_URL="postgresql://teamdivergent:teamdivergent123@127.0.0.1:5432/teamdivergente"

# Server Configuration (OPTIONNEL avec fallback)
# Port d'écoute du serveur NestJS (fallback: 3000)
PORT=3000

# Swagger (OPTIONNEL)
# Activer/désactiver la documentation Swagger (mettre à false en production)
SWAGGER_ENABLED=true

# Twitch Helix API (OPTIONNEL — mode dégradé si absents)
# Créer une application sur https://dev.twitch.tv/console/apps
# Le service retournera "hors-ligne" pour tous les streamers si ces variables sont absentes.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Boutique / Stripe
# OBLIGATOIRE si la boutique est activee : cle secrete API Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=
# OBLIGATOIRE si la boutique est activee : secret de signature du webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Les frais de port ne sont plus une variable d'environnement : le montant vit
# en base (table shop_settings) et s'edite depuis /admin/boutique. Il est
# transmis a Stripe en shipping_options inline a chaque session, ce qui evite
# d'avoir a resynchroniser un objet tarif chez Stripe a chaque changement.
# OPTIONNEL : URL de retour apres paiement reussi (defaut http://localhost:4200/boutique/merci)
SHOP_SUCCESS_URL=
# OPTIONNEL : URL de retour apres annulation (defaut http://localhost:4200/boutique/panier)
SHOP_CANCEL_URL=
# OPTIONNEL : origine publique du site, utilisee pour les liens legaux (CGV,
# retractation, confidentialite) du mail de confirmation client.
# A defaut, l'origine est derivee de SHOP_SUCCESS_URL. Sans repli exploitable,
# elle retombe sur http://localhost:4200.
SHOP_PUBLIC_URL=
# OPTIONNEL : delai de livraison annonce au client dans le mail de confirmation
# (obligation precontractuelle, art. L221-13 C. conso).
# Si absente, le mail annonce le delai suppletif legal de 30 jours (art. L216-1
# C. conso) et une erreur est journalisee : renseigner le delai reel de
# l'atelier avant l'ouverture de la boutique.
# Exemple : SHOP_DELIVERY_DELAY_TEXT="25 jours ouvres au plus tard"
SHOP_DELIVERY_DELAY_TEXT=