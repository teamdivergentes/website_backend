  "scripts": {
    "build": "nest build",
    "build:seed": "tsc prisma/seed.ts --outDir dist --rootDir . --module commonjs --moduleResolution node --target es2023 --esModuleInterop --skipLibCheck",
    "db:seed:prod": "node dist/prisma/seed.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --cache --cache-location .eslintcache --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "cleanup:images": "ts-node scripts/cleanup-orphan-images.ts",
    "test:mutation": "stryker run",
    "prepare": "husky 2>/dev/null || true"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
