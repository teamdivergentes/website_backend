generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isSystem    Boolean  @default(false)
  users       User[]

  @@map("roles")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  roleId    Int
  actif     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Role      @relation(fields: [roleId], references: [id])
  articles  Article[]

  @@map("users")
}

model Config {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?

  @@map("configs")
}

model StaffMember {
  id        Int           @id @default(autoincrement())
  name      String
  role      String
  image     String?
  category  StaffCategory
  position  Int           @default(0)
  socials   Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("staff_members")
}

model Team {
  id                 Int          @id @default(autoincrement())
  name               String
  slug               String       @unique
  game               String
  image              String?
  banner             String?
  description        String?
  active             Boolean      @default(true)
  position           Int          @default(0)
  socials            Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  memberFieldsConfig Json?
  members            TeamMember[]

  @@map("teams")
}

model TeamMember {
  id           Int       @id @default(autoincrement())
  name         String
  realName     String?
  role         String
  image        String?
  teamId       Int
  position     Int       @default(0)
  socials      Json?
  joinedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  nationality  String?
  birthDate    DateTime?
  biography    String?
  customFields Json?
  slug         String?   @unique
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

model Game {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  image     String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("games")
}

model Sponsor {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  position    Int            @default(0)
  active      Boolean        @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  imageLayout ImageLayout    @default(LAYOUT_1)
  images      SponsorImage[]
  links       SponsorLink[]

  @@map("sponsors")
}

model SponsorImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  sponsorId Int
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("sponsor_images")
}

model SponsorLink {
  id        Int      @id @default(autoincrement())
  url       String
  label     String
  type      LinkType @default(WEBSITE)
  isPrimary Boolean  @default(false)
  sponsorId Int
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("sponsor_links")
}

enum StaffCategory {
  ADMIN
  HEADSTAFF
  AMBASSADOR

  @@map("staff_category")
}

enum LinkType {
  WEBSITE
  TWITTER
  INSTAGRAM
  DISCORD
  PROMO_CODE
  OTHER

  @@map("link_type")
}

enum ImageLayout {
  LAYOUT_1
  LAYOUT_2
  LAYOUT_3

  @@map("image_layout")
}

model ArticleType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("article_types")
}

model Article {
  id             Int         @id @default(autoincrement())
  title          String
  slug           String      @unique
  content        String      @db.Text
  excerpt        String?     @db.Text
  imageUrl       String?     @map("image_url")
  mobileImageUrl String?     @map("mobile_image_url")
  tabletImageUrl String?     @map("tablet_image_url")
  published      Boolean     @default(false)
  featured       Boolean     @default(false)
  typeId         Int         @map("type_id")
  userId         Int         @map("user_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  type           ArticleType @relation(fields: [typeId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@index([typeId])
  @@index([published, featured])
  @@map("articles")
}

model RecruitmentPost {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  description String   @db.Text
  image       String?
  active      Boolean  @default(true)
  position    Int      @default(0)
  slug          String?  @unique
  location      String?
  duration      String?
  missions      String?  @db.Text
  skills        String?  @db.Text
  requirements  String?  @db.Text
  benefits      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("recruitment_posts")
}
