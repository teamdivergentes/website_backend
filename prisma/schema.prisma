generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isSystem    Boolean  @default(false)
  users       User[]

  @@map("roles")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  roleId       Int
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  role         Role      @relation(fields: [roleId], references: [id])
  articles     Article[]
  /// Commandes passees au tarif reserve. Vide pour la plupart des comptes.
  retailOrders Order[]

  @@map("users")
}

model Config {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?

  @@map("configs")
}

model StaffMember {
  id        Int           @id @default(autoincrement())
  name      String
  role      String
  image     String?
  category  StaffCategory
  position  Int           @default(0)
  socials   Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("staff_members")
}

model Team {
  id                 Int             @id @default(autoincrement())
  name               String
  slug               String          @unique
  game               String
  image              String?
  banner             String?
  description        String?
  active             Boolean         @default(true)
  position           Int             @default(0)
  socials            Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  memberFieldsConfig Json?
  members            TeamMember[]
  coachingStaff      CoachingStaff[]
  trophies           Trophy[]
  matches            Match[]
  shopProducts       ShopProduct[]

  @@map("teams")
}

model TeamMember {
  id             Int             @id @default(autoincrement())
  name           String
  realName       String?
  role           String
  image          String?
  teamId         Int
  position       Int             @default(0)
  socials        Json?
  joinedAt       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  nationality    String?
  birthDate      DateTime?
  biography      String?
  customFields   Json?
  slug           String?         @unique
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  twitchChannels TwitchChannel[]

  @@index([teamId])
  @@map("team_members")
}

model Game {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  image     String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("games")
}

model Sponsor {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  position    Int            @default(0)
  active      Boolean        @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  imageLayout ImageLayout    @default(LAYOUT_1)
  images      SponsorImage[]
  links       SponsorLink[]

  @@map("sponsors")
}

model SponsorImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  sponsorId Int
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("sponsor_images")
}

model SponsorLink {
  id        Int      @id @default(autoincrement())
  url       String
  label     String
  type      LinkType @default(WEBSITE)
  isPrimary Boolean  @default(false)
  sponsorId Int
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("sponsor_links")
}

enum StaffCategory {
  ADMIN
  HEADSTAFF
  AMBASSADOR

  @@map("staff_category")
}

enum LinkType {
  WEBSITE
  TWITTER
  INSTAGRAM
  DISCORD
  PROMO_CODE
  OTHER

  @@map("link_type")
}

enum ImageLayout {
  LAYOUT_1
  LAYOUT_2
  LAYOUT_3

  @@map("image_layout")
}

model ArticleType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("article_types")
}

model Article {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  content        String   @db.Text
  excerpt        String?  @db.Text
  imageUrl       String?  @map("image_url")
  mobileImageUrl String?  @map("mobile_image_url")
  tabletImageUrl String?  @map("tablet_image_url")
  published      Boolean  @default(false)
  featured       Boolean  @default(false)
  typeId         Int      @map("type_id")
  userId         Int      @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  type    ArticleType @relation(fields: [typeId], references: [id])
  user    User        @relation(fields: [userId], references: [id])
  matches Match[]

  @@index([typeId])
  @@index([published, featured])
  @@map("articles")
}

model TwitchChannel {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  displayName  String?
  gameLabel    String?
  description  String?
  active       Boolean     @default(true)
  position     Int         @default(0)
  teamMemberId Int?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, position])
  @@index([teamMemberId])
  @@map("twitch_channels")
}

model CoachingStaff {
  id           Int       @id @default(autoincrement())
  teamId       Int
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  realName     String?
  role         String
  image        String?
  biography    String?
  position     Int       @default(0)
  socials      Json?
  slug         String?   @unique
  nationality  String?
  birthDate    DateTime?
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([teamId, position])
  @@map("coaching_staff")
}

model RecruitmentPost {
  id           Int      @id @default(autoincrement())
  title        String
  type         String
  description  String   @db.Text
  image        String?
  active       Boolean  @default(true)
  position     Int      @default(0)
  slug         String?  @unique
  location     String?
  duration     String?
  missions     String?  @db.Text
  skills       String?  @db.Text
  requirements String?  @db.Text
  benefits     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("recruitment_posts")
}

model Trophy {
  id          Int      @id @default(autoincrement())
  competition String
  placement   Int
  description String?
  date        DateTime
  image       String?
  featured    Boolean  @default(false)
  teamId      Int?
  teamLabel   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([active, featured])
  @@map("trophies")
}

model Match {
  id               Int      @id @default(autoincrement())
  teamId           Int?
  teamNameSnapshot String?
  opponentName     String
  opponentLogo     String?
  scheduledAt      DateTime
  competition      String?
  streamUrl        String?
  scoreDvg         Int?
  scoreOpponent    Int?
  articleId        Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  article          Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([scheduledAt])
  @@map("matches")
}

/// Catalogue boutique. Editable depuis l'admin : prix, visuels et activation
/// changent sans redeploiement.
model ShopProduct {
  id               Int                @id @default(autoincrement())
  slug             String             @unique
  name             String
  shortDescription String?
  /// Texte brut, jamais du HTML : il est rendu par interpolation cote front.
  description      String?            @db.Text
  priceCents       Int
  /// Prix promotionnel, applique a tous les clients pendant sa fenetre.
  ///
  /// Un montant et non un pourcentage : la vitrine affiche des montants, et un
  /// taux ferait un arrondi au centime recalcule a chaque rendu — donc, tot ou
  /// tard, deux ecrans qui n'affichent pas le meme prix.
  ///
  /// `priceCents` ne bouge pas pendant la promotion. C'est ce qui permet a la
  /// fois d'afficher le prix barre, de restituer le tarif normal a l'echeance
  /// sans intervention, et de garder `publicTotalCents` interpretable.
  promoPriceCents  Int?
  /// Fenetre de la promotion. Une borne nulle est ouverte : sans debut, la
  /// promotion court des sa saisie ; sans fin, elle n'a pas d'echeance.
  promoStartsAt    DateTime?
  promoEndsAt      DateTime?
  allowFlocking    Boolean            @default(true)
  flockingFeeCents Int                @default(0)
  /// Position de l'apercu du flocage sur l'image de dos, en % (affichage seul).
  /// Le defaut est mesure sur les visuels 2026, composes au rapport 4/5 : il ne
  /// vaut que pour des fichiers de meme cadrage.
  flockingTopPct   Float              @default(34.75)
  flockingLeftPct  Float              @default(50)
  teamId           Int?
  /// Faux par defaut : un produit sans visuel ne doit pas atterrir en vitrine.
  active           Boolean            @default(false)
  position         Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  team             Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sizes            ShopProductSize[]
  images           ShopProductImage[]
  orderItems       OrderItem[]

  @@index([active, position])
  @@index([teamId])
  @@map("shop_products")
}

model ShopProductSize {
  id        Int         @id @default(autoincrement())
  productId Int
  label     String
  position  Int         @default(0)
  /// Stock restant pour cette taille. `null` = non gere, illimite : c'est le
  /// comportement d'avant cette colonne, et il reste le defaut de toute taille
  /// existante. Un entier >= 0 active le suivi ; il est decremente au paiement
  /// confirme (webhook), jamais a l'ajout au panier, pour ne pas reserver un
  /// stock sur un panier qui ne sera peut-etre jamais paye.
  ///
  /// Jamais expose tel quel au public : seul un booleen `inStock` derive
  /// atteint le catalogue, pour ne pas divulguer un volume de vente.
  stock     Int?
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@index([productId])
  @@map("shop_product_sizes")
}

/// Visuel d'un produit. Une collection plutot que des colonnes fixes : chaque
/// declinaison n'a pas le meme nombre de vues, et en ajouter une ne doit pas
/// demander une migration.
model ShopProductImage {
  id        Int         @id @default(autoincrement())
  productId Int
  url       String
  /// Ce qui est ecrit sous la vignette du rail : « face », « dos », « porte ».
  label     String
  /// Ordre d'affichage. La position 0 est la vue d'ouverture de la fiche.
  position  Int         @default(0)
  /// Vue de dos : l'apercu du flocage doit savoir sur quelle image se poser.
  isBack    Boolean     @default(false)
  /// Vignette de la liste boutique. Au plus une par produit, le service s'en
  /// assure ; a defaut c'est la premiere image qui sert.
  isCard    Boolean     @default(false)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("shop_product_images")
}

/// Singleton (id = 1). Parametres operationnels de la boutique.
model ShopSettings {
  id                Int     @id @default(1)
  currency          String  @default("eur")
  ordersNotifyEmail String?
  /// Permet de fermer la boutique sans depublier chaque produit.
  shopEnabled       Boolean @default(false)

  // --- Ce que paie le client -------------------------------------------
  /// Livraison facturee au client. Un seul mode depuis le retrait de l'option
  /// rapide, dont le delai annonce n'etait couvert par aucun tarif fournisseur.
  shippingStandardCents      Int @default(500)
  /// Panier a partir duquel la livraison est offerte. 0 desactive la franchise.
  freeShippingThresholdCents Int @default(12000)

  // --- Ce que ca coute a la structure ----------------------------------
  // Ces montants ne sont jamais exposes au public : ils ne servent qu'au
  // calcul de marge de l'espace d'administration.
  //
  // ⚠️ Tous les couts fournisseur sont saisis **TVA lettone comprise**, soit
  // le tarif HT majore de 21 %. Le fabricant est etabli a Riga et facture avec
  // sa TVA locale ; l'association, en franchise en base, ne la recupere pas.
  // C'est donc bien ce montant-la qui sort de la tresorerie. Prendre un
  // numero de TVA intracommunautaire ferait tomber ces montants au HT, mais
  // obligerait aussi a collecter la TVA sur les ventes : en vente au
  // consommateur, le calcul est defavorable.
  /// Fabrication d'un maillot chez le fournisseur. 16,19 € HT.
  ///
  /// ⚠️ Le tarif fournisseur est **degressif par volume** : 16,19 € de 1 a 4
  /// pieces, 13,66 € de 5 a 29, 12,85 € de 30 a 99. Ce champ ne porte qu'une
  /// valeur, calee sur le palier le plus cher. Comme les commandes partent par
  /// lots hebdomadaires, le palier reellement applique depend du lot et non de
  /// la commande : la marge affichee est donc un plancher, jamais surestimee.
  costProductionCents       Int     @default(1959)
  /// Commission d'un partenaire, par maillot. Desactivee tant que
  /// `costPartnerEnabled` est faux : le partenariat n'existe pas au lancement.
  costPartnerCents          Int     @default(700)
  costPartnerEnabled        Boolean @default(false)
  /// Frais de traitement factures par le fournisseur, **par commande et non
  /// par maillot** (« e-commerce order handling fee », 3,00 € HT).
  ///
  /// Ne couvre **pas** les frais Stripe : ceux-ci sont preleves par Stripe, pas
  /// par le fournisseur, et sont figes commande par commande dans
  /// `Order.stripeFeeCents` a leur montant reel.
  costEcommerceCents        Int     @default(363)
  /// Cout fournisseur du flocage. Inconnu a ce jour, provisionne a zero :
  /// une marge calculee avec un cout invente serait pire qu'une marge large.
  costFlockingCents         Int     @default(0)
  /// Cout reel d'un colis. La livraison est vendue a perte, c'est assume : ce
  /// montant le rend visible plutot que de le masquer. 9,00 € HT, tarif postal
  /// identique sur toute la zone livree.
  costShippingStandardCents Int     @default(1089)

  updatedAt DateTime @updatedAt

  @@map("shop_settings")
}

/// Bon de reduction saisi par le client au panier.
///
/// C'est la seule donnee tarifaire que le client transmet, et elle voyage comme
/// un **identifiant** : la valeur de la remise est resolue ici, jamais lue dans
/// la requete. Sans cela, un panier forge achete un maillot a 0,01 EUR.
model ShopDiscountCode {
  id    Int          @id @default(autoincrement())
  /// Stocke en majuscules. Postgres compare les chaines avec la casse, et un
  /// code se dicte, se recopie et se retape : la normalisation a l'ecriture
  /// est ce qui rend l'unicite et la recherche reellement insensibles a la
  /// casse, sans index fonctionnel.
  code  String       @unique
  type  DiscountType
  /// Centimes pour `FIXED`, points de pourcentage pour `PERCENTAGE`.
  value Int

  /// Sous-total articles a partir duquel le code s'applique. Null = pas de
  /// minimum. La convention « vide = pas de limite » vaut pour les quatre
  /// bornes de ce modele, comme pour la franchise de port.
  minSubtotalCents Int?
  startsAt         DateTime?
  endsAt           DateTime?
  /// Nombre total d'utilisations autorisees, null = illimite. A `1`, le code
  /// est a usage unique : le premier paiement l'epuise pour tout le monde.
  maxUses          Int?

  /// Incremente au passage en `PAID`, jamais a l'ouverture d'une session de
  /// paiement : un panier abandonne ne doit pas bruler un code, et le tunnel
  /// en produit mecaniquement. Les sessions encore vivantes sont comptees a
  /// part, via les commandes `PENDING` qui portent le code.
  usedCount Int     @default(0)
  /// Interrupteur immediat, independant de la fenetre de validite.
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([active])
  @@map("shop_discount_codes")
}

/// Nature d'un bon de reduction.
enum DiscountType {
  /// Montant fixe en centimes : « 5 EUR de reduction ».
  FIXED
  /// Pourcentage du sous-total articles : « 10 % de reduction ».
  PERCENTAGE
}

model Order {
  id                    Int     @id @default(autoincrement())
  reference             String  @unique
  stripeSessionId       String  @unique
  stripePaymentIntentId String?

  subtotalCents  Int            @default(0)
  shippingCents  Int
  totalCents     Int
  currency       String         @default("eur")
  shippingMethod ShippingMethod @default(STANDARD)

  /// Remise reellement deduite, en centimes. Zero et non `null` sur une
  /// commande sans remise : le reporting somme sans cas particulier.
  ///
  /// C'est le montant qui est fige, pas une reference aux conditions du code :
  /// celles-ci sont modifiables a chaud, et les recalculer plus tard
  /// reecrirait l'histoire — la meme raison qui fait figer les couts.
  discountCents Int     @default(0)
  /// Libelle du code au moment de l'achat. Duplique volontairement la
  /// relation : c'est lui qui rattache une vente a son operation commerciale
  /// meme si le code a ete renomme, desactive ou supprime depuis.
  discountCode  String?

  /// Le code utilise, quand il existe encore. Sert a compter les utilisations
  /// et les reservations ; le rapprochement d'une operation, lui, passe par
  /// `discountCode`.
  discountCodeId Int?
  discount       ShopDiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  /// Echeance de la session de paiement Stripe.
  ///
  /// Une commande `PENDING` dont la session est encore vivante **reserve** son
  /// code de reduction : sans cela, deux clients qui paient a quelques
  /// secondes d'intervalle obtiennent tous deux un code a usage unique, et
  /// refuser le second est impossible puisqu'il a deja paye.
  ///
  /// ⚠️ Ne pas confondre avec le delai de retention des `PENDING` abandonnees,
  /// qui est de plusieurs jours : s'appuyer sur lui bloquerait un code une
  /// semaine sur un simple panier abandonne.
  sessionExpiresAt DateTime?

  /// Couts figes a l'achat. Une marge est une photographie : si le tarif du
  /// fournisseur change demain, les commandes d'hier ne doivent pas changer de
  /// marge pour autant. `unitCostCents` inclut deja la commission partenaire
  /// si elle etait active au moment de la commande.
  unitCostCents     Int @default(0)
  shippingCostCents Int @default(0)

  /// Frais de traitement du fournisseur, dus **une fois par commande**. Ils ne
  /// peuvent pas vivre dans `unitCostCents`, qui est multiplie par la quantite :
  /// une commande de trois maillots ne paie pas trois fois le traitement.
  orderFeeCents Int @default(0)

  /// Commission Stripe reellement prelevee, lue sur la transaction de solde au
  /// moment du paiement.
  ///
  /// Montant constate et non estime : le taux depend du pays d'emission de la
  /// carte, et une carte suisse coute pres du double d'une carte de la zone
  /// europeenne. Le lire evite d'avoir a poser une hypothese sur la clientele.
  /// Vaut 0 quand Stripe n'a pas encore arrete le montant — paiement differe,
  /// ou API injoignable au moment du webhook : la marge est alors surestimee
  /// de quelques dizaines de centimes, jamais l'inverse.
  stripeFeeCents Int @default(0)

  /// Bareme applique. `PUBLIC` par defaut : une commande dont on ne sait rien
  /// est une vente ordinaire, jamais une vente a prix coutant.
  pricingTier PricingTier @default(PUBLIC)

  /// Qui a beneficie du tarif, sur une commande `RETAIL`. Null sur une vente
  /// publique : le tunnel public est anonyme. `SetNull` a la suppression du
  /// compte — une commande reste une piece comptable, elle ne disparait pas
  /// avec son acheteur.
  buyerUserId Int?
  buyer       User? @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)

  /// Ce que la meme commande aurait coute au prix catalogue, fige a l'achat.
  ///
  /// Sans ce montant, l'ecart entre prix public et prix paye est
  /// irreconstituable : le catalogue est modifiable a chaud, et le prix
  /// d'aujourd'hui n'est pas celui du jour de la commande. Or c'est exactement
  /// cet ecart qu'il faut produire si la question de l'avantage en nature se
  /// pose. Egal a `totalCents` sur une vente publique.
  publicTotalCents Int @default(0)

  /// Renseignes par le webhook : inconnus tant que le client n'a pas paye.
  customerEmail String @default("")
  customerName  String @default("")

  /// Prenom et nom saisis separement sur la page de paiement, via les champs
  /// personnalises de Stripe.
  ///
  /// `customerName` reste le nom complet du bloc d'adresse, celui qui part sur
  /// l'etiquette d'expedition ; ces deux champs-ci portent l'identite telle que
  /// le client la decoupe lui-meme. On en tirait le prenom en prenant le
  /// premier mot de `customerName`, ce qui se trompait sur « Dupont Jean »
  /// comme sur un pseudo.
  ///
  /// Vides sur toute commande anterieure a leur introduction, d'ou le defaut :
  /// le code appelant doit retomber sur `customerName` quand ils le sont.
  customerFirstName String @default("")
  customerLastName  String @default("")
  shippingAddress   Json   @default("{}")

  status           OrderStatus @default(PAID)
  sentToMerchantAt DateTime?
  merchantBatchId  String?
  trackingNumber   String?
  adminNote        String?     @db.Text

  /// Identifiant du remboursement Stripe, pose au remboursement integral
  /// declenche depuis l'admin. Distinct de `stripePaymentIntentId` : l'un paie,
  /// l'autre rembourse, et une commande peut un jour porter les deux sans que
  /// l'un efface l'autre.
  stripeRefundId String?
  /// Horodatage du remboursement, `null` tant qu'aucun n'a ete effectue.
  refundedAt     DateTime?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([status])
  @@index([merchantBatchId])
  @@index([createdAt])
  /// Le reporting filtre sur le bareme : les ventes a prix coutant sortent des
  /// ratios de performance, et un quota par personne se compte par acheteur.
  @@index([pricingTier])
  @@index([buyerUserId])
  /// Valider un code demande de compter ses commandes payees et ses sessions
  /// encore ouvertes. Les deux se lisent sur ce couple.
  @@index([discountCodeId, status])
  @@map("orders")
}

/// Ligne de commande. Tous les libelles et montants sont des instantanes figes
/// a l'achat : le catalogue etant editable a chaud, une commande de mars doit
/// rester lisible avec le prix de mars.
model OrderItem {
  id               Int          @id @default(autoincrement())
  orderId          Int
  productId        Int?
  productName      String
  size             String
  flockingText     String?
  quantity         Int
  unitPriceCents   Int
  flockingFeeCents Int          @default(0)
  lineTotalCents   Int
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Mode d'acheminement d'une commande.
///
/// ⚠️ `EXPRESS` n'est plus proposable : l'option « rapide » a ete retiree de la
/// boutique. Elle annoncait un acheminement en 2 a 3 jours ouvres qu'aucune
/// ligne de la grille fournisseur ne garantissait — celle-ci ne propose qu'une
/// production acceleree a +30 % et un transporteur reserve aux commandes en
/// gros. Or le delai annonce engage le vendeur (art. L216-1 C. conso).
///
/// La valeur reste dans l'enum parce que des commandes l'ont portee : la
/// retirer rendrait ces lignes illisibles. Rien ne doit plus la produire.
enum ShippingMethod {
  STANDARD
  EXPRESS
}

/// Bareme applique a une commande. Choisi par le SERVEUR a partir de l'identite
/// authentifiee, jamais transmis par le client.
enum PricingTier {
  /// Prix catalogue. Le cas de tout le monde.
  PUBLIC
  /// Prix coutant, reserve aux porteurs de `boutique:retail`. Marge nulle par
  /// construction : ces commandes doivent sortir des ratios de performance.
  RETAIL
}

enum OrderStatus {
  /// Session de paiement creee, paiement pas encore confirme. Les lignes sont
  /// persistees des le checkout car les metadonnees Stripe (500 caracteres par
  /// valeur) ne peuvent pas porter un panier multi-articles avec flocages.
  /// Seul le webhook signe fait passer une commande en PAID.
  PENDING
  PAID
  SENT_TO_MERCHANT
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
