generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isSystem    Boolean  @default(false)
  users       User[]

  @@map("roles")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  roleId    Int
  actif     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Role      @relation(fields: [roleId], references: [id])
  articles  Article[]

  @@map("users")
}

model Config {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?

  @@map("configs")
}

model StaffMember {
  id        Int           @id @default(autoincrement())
  name      String
  role      String
  image     String?
  category  StaffCategory
  position  Int           @default(0)
  socials   Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("staff_members")
}

model Team {
  id                 Int             @id @default(autoincrement())
  name               String
  slug               String          @unique
  game               String
  image              String?
  banner             String?
  description        String?
  active             Boolean         @default(true)
  position           Int             @default(0)
  socials            Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  memberFieldsConfig Json?
  members            TeamMember[]
  coachingStaff      CoachingStaff[]
  trophies           Trophy[]
  matches            Match[]
  shopProducts       ShopProduct[]

  @@map("teams")
}

model TeamMember {
  id              Int              @id @default(autoincrement())
  name            String
  realName        String?
  role            String
  image           String?
  teamId          Int
  position        Int              @default(0)
  socials         Json?
  joinedAt        DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  nationality     String?
  birthDate       DateTime?
  biography       String?
  customFields    Json?
  slug            String?          @unique
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  twitchChannels  TwitchChannel[]

  @@index([teamId])
  @@map("team_members")
}

model Game {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  image     String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("games")
}

model Sponsor {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  position    Int            @default(0)
  active      Boolean        @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  imageLayout ImageLayout    @default(LAYOUT_1)
  images      SponsorImage[]
  links       SponsorLink[]

  @@map("sponsors")
}

model SponsorImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  sponsorId Int
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("sponsor_images")
}

model SponsorLink {
  id        Int      @id @default(autoincrement())
  url       String
  label     String
  type      LinkType @default(WEBSITE)
  isPrimary Boolean  @default(false)
  sponsorId Int
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("sponsor_links")
}

enum StaffCategory {
  ADMIN
  HEADSTAFF
  AMBASSADOR

  @@map("staff_category")
}

enum LinkType {
  WEBSITE
  TWITTER
  INSTAGRAM
  DISCORD
  PROMO_CODE
  OTHER

  @@map("link_type")
}

enum ImageLayout {
  LAYOUT_1
  LAYOUT_2
  LAYOUT_3

  @@map("image_layout")
}

model ArticleType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("article_types")
}

model Article {
  id             Int         @id @default(autoincrement())
  title          String
  slug           String      @unique
  content        String      @db.Text
  excerpt        String?     @db.Text
  imageUrl       String?     @map("image_url")
  mobileImageUrl String?     @map("mobile_image_url")
  tabletImageUrl String?     @map("tablet_image_url")
  published      Boolean     @default(false)
  featured       Boolean     @default(false)
  typeId         Int         @map("type_id")
  userId         Int         @map("user_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  type           ArticleType @relation(fields: [typeId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  matches        Match[]

  @@index([typeId])
  @@index([published, featured])
  @@map("articles")
}

model TwitchChannel {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  displayName  String?
  gameLabel    String?
  description  String?
  active       Boolean     @default(true)
  position     Int         @default(0)
  teamMemberId Int?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, position])
  @@index([teamMemberId])
  @@map("twitch_channels")
}

model CoachingStaff {
  id           Int       @id @default(autoincrement())
  teamId       Int
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  realName     String?
  role         String
  image        String?
  biography    String?
  position     Int       @default(0)
  socials      Json?
  slug         String?   @unique
  nationality  String?
  birthDate    DateTime?
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([teamId, position])
  @@map("coaching_staff")
}

model RecruitmentPost {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  description String   @db.Text
  image       String?
  active      Boolean  @default(true)
  position    Int      @default(0)
  slug          String?  @unique
  location      String?
  duration      String?
  missions      String?  @db.Text
  skills        String?  @db.Text
  requirements  String?  @db.Text
  benefits      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("recruitment_posts")
}

model Trophy {
  id          Int      @id @default(autoincrement())
  competition String
  placement   Int
  description String?
  date        DateTime
  image       String?
  featured    Boolean  @default(false)
  teamId      Int?
  teamLabel   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([active, featured])
  @@map("trophies")
}

model Match {
  id               Int      @id @default(autoincrement())
  teamId           Int?
  teamNameSnapshot String?
  opponentName     String
  opponentLogo     String?
  scheduledAt      DateTime
  competition      String?
  streamUrl        String?
  scoreDvg         Int?
  scoreOpponent    Int?
  articleId        Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  article          Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([scheduledAt])
  @@map("matches")
}

/// Catalogue boutique. Editable depuis l'admin : prix, visuels et activation
/// changent sans redeploiement.
model ShopProduct {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  name             String
  shortDescription String?
  /// Texte brut, jamais du HTML : il est rendu par interpolation cote front.
  description      String?           @db.Text
  priceCents       Int
  allowFlocking    Boolean           @default(true)
  flockingFeeCents Int               @default(0)
  /// Position de l'apercu du flocage sur l'image de dos, en % (affichage seul).
  flockingTopPct   Float             @default(32)
  flockingLeftPct  Float             @default(50)
  teamId           Int?
  /// Faux par defaut : un produit sans visuel ne doit pas atterrir en vitrine.
  active           Boolean           @default(false)
  position         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sizes            ShopProductSize[]
  images           ShopProductImage[]
  orderItems       OrderItem[]

  @@index([active, position])
  @@index([teamId])
  @@map("shop_products")
}

model ShopProductSize {
  id        Int         @id @default(autoincrement())
  productId Int
  label     String
  position  Int         @default(0)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@index([productId])
  @@map("shop_product_sizes")
}

/// Visuel d'un produit. Une collection plutot que des colonnes fixes : chaque
/// declinaison n'a pas le meme nombre de vues, et en ajouter une ne doit pas
/// demander une migration.
model ShopProductImage {
  id        Int         @id @default(autoincrement())
  productId Int
  url       String
  /// Ce qui est ecrit sous la vignette du rail : « face », « dos », « porte ».
  label     String
  /// Ordre d'affichage. La position 0 est la vue d'ouverture de la fiche.
  position  Int         @default(0)
  /// Vue de dos : l'apercu du flocage doit savoir sur quelle image se poser.
  isBack    Boolean     @default(false)
  /// Vignette de la liste boutique. Au plus une par produit, le service s'en
  /// assure ; a defaut c'est la premiere image qui sert.
  isCard    Boolean     @default(false)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("shop_product_images")
}

/// Singleton (id = 1). Parametres operationnels de la boutique.
model ShopSettings {
  id                Int      @id @default(1)
  currency          String   @default("eur")
  ordersNotifyEmail String?
  /// Permet de fermer la boutique sans depublier chaque produit.
  shopEnabled       Boolean  @default(false)

  // --- Ce que paie le client -------------------------------------------
  /// Livraison standard facturee au client.
  shippingStandardCents      Int @default(500)
  /// Livraison rapide facturee au client.
  shippingExpressCents       Int @default(1000)
  /// Panier a partir duquel la livraison est offerte, quel que soit le mode.
  /// 0 desactive la franchise.
  freeShippingThresholdCents Int @default(12000)

  // --- Ce que ca coute a la structure ----------------------------------
  // Ces montants ne sont jamais exposes au public : ils ne servent qu'au
  // calcul de marge de l'espace d'administration.
  /// Fabrication d'un maillot chez le fournisseur.
  costProductionCents        Int     @default(1600)
  /// Commission d'un partenaire, par maillot. Desactivee tant que
  /// `costPartnerEnabled` est faux : le partenariat n'existe pas au lancement.
  costPartnerCents           Int     @default(700)
  costPartnerEnabled         Boolean @default(false)
  /// Frais de plateforme et de paiement, par maillot.
  costEcommerceCents         Int     @default(300)
  /// Cout fournisseur du flocage. Inconnu a ce jour, provisionne a zero :
  /// une marge calculee avec un cout invente serait pire qu'une marge large.
  costFlockingCents          Int     @default(0)
  /// Cout reel d'un colis, par mode. La livraison est vendue a perte, c'est
  /// assume : ces montants le rendent visible plutot que de le masquer.
  costShippingStandardCents  Int     @default(900)
  costShippingExpressCents   Int     @default(1200)

  updatedAt         DateTime @updatedAt

  @@map("shop_settings")
}

model Order {
  id                    Int         @id @default(autoincrement())
  reference             String      @unique
  stripeSessionId       String      @unique
  stripePaymentIntentId String?

  subtotalCents         Int         @default(0)
  shippingCents         Int
  totalCents            Int
  currency              String      @default("eur")
  shippingMethod        ShippingMethod @default(STANDARD)

  /// Couts figes a l'achat. Une marge est une photographie : si le tarif du
  /// fournisseur change demain, les commandes d'hier ne doivent pas changer de
  /// marge pour autant. `unitCostCents` inclut deja la commission partenaire
  /// si elle etait active au moment de la commande.
  unitCostCents         Int         @default(0)
  shippingCostCents     Int         @default(0)

  /// Renseignes par le webhook : inconnus tant que le client n'a pas paye.
  customerEmail         String      @default("")
  customerName          String      @default("")
  shippingAddress       Json        @default("{}")

  status                OrderStatus @default(PAID)
  sentToMerchantAt      DateTime?
  merchantBatchId       String?
  trackingNumber        String?
  adminNote             String?     @db.Text

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]

  @@index([status])
  @@index([merchantBatchId])
  @@index([createdAt])
  @@map("orders")
}

/// Ligne de commande. Tous les libelles et montants sont des instantanes figes
/// a l'achat : le catalogue etant editable a chaud, une commande de mars doit
/// rester lisible avec le prix de mars.
model OrderItem {
  id               Int          @id @default(autoincrement())
  orderId          Int
  productId        Int?
  productName      String
  size             String
  flockingText     String?
  quantity         Int
  unitPriceCents   Int
  flockingFeeCents Int          @default(0)
  lineTotalCents   Int
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum OrderStatus {
  /// Session de paiement creee, paiement pas encore confirme. Les lignes sont
  /// persistees des le checkout car les metadonnees Stripe (500 caracteres par
  /// valeur) ne peuvent pas porter un panier multi-articles avec flocages.
  /// Seul le webhook signe fait passer une commande en PAID.
  PENDING
  PAID
  SENT_TO_MERCHANT
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
